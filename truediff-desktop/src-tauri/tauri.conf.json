{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "truediff-desktop",
  "version": "0.1.0",
  "identifier": "com.tomasslimited.truediff",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TrueDiff Pro",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
